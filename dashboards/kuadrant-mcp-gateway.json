      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (server_name) (mcp_broker_tools_list_response_bytes{namespace=~\"$namespace\", pod=~\"$pod\", server_name=~\"$server\"})",
          "legendFormat": "{{server_name}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "table",
      "title": "Upstream servers",
      "description": "Tools, tools/list size and connection failures over the range per upstream server.",
