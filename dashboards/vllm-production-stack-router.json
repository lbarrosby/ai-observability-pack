          "expr": "sum by (error_type, server) (rate(vllm:request_errors_total{namespace=~\"$namespace\", pod=~\"$pod\", model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "{{error_type}} {{server}}",
          "refId": "A",
          "range": true
        }
