      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (model) (rate(nv_inference_queue_duration_us{namespace=~\"$namespace\", pod=~\"$pod\", model=~\"$model\"}[$__rate_interval])) / (sum by (model) (rate(nv_inference_request_success{namespace=~\"$namespace\", pod=~\"$pod\", model=~\"$model\"}[$__rate_interval])) + sum by (model) (rate(nv_inference_request_failure{namespace=~\"$namespace\", pod=~\"$pod\", model=~\"$model\"}[$__rate_interval])))",
          "legendFormat": "queue {{model}}",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (model) (rate(nv_inference_compute_input_duration_us{namespace=~\"$namespace\", pod=~\"$pod\", model=~\"$model\"}[$__rate_interval])) / (sum by (model) (rate(nv_inference_request_success{namespace=~\"$namespace\", pod=~\"$pod\", model=~\"$model\"}[$__rate_interval])) + sum by (model) (rate(nv_inference_request_failure{namespace=~\"$namespace\", pod=~\"$pod\", model=~\"$model\"}[$__rate_interval])))",
          "legendFormat": "input {{model}}",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
