          "editorMode": "code",
          "expr": "sum(rate(nv_inference_count{namespace=~\"$namespace\", pod=~\"$pod\", model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Avg batch size",
      "description": "Inferences per execution. Near 1 means dynamic batching is not kicking in.",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
