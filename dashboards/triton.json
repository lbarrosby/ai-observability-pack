          "editorMode": "code",
          "expr": "sum(rate(nv_inference_request_duration_us{namespace=~\"$namespace\", pod=~\"$pod\", model=~\"$model\"}[$__rate_interval])) / (sum(rate(nv_inference_request_success{namespace=~\"$namespace\", pod=~\"$pod\", model=~\"$model\"}[$__rate_interval])) + sum(rate(nv_inference_request_failure{namespace=~\"$namespace\", pod=~\"$pod\", model=~\"$model\"}[$__rate_interval])))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "row",
