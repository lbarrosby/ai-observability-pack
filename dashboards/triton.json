          "editorMode": "code",
          "expr": "sum(rate(nv_inference_count{namespace=~\"$namespace\", pod=~\"$pod\", model=~\"$model\"}[$__rate_interval])) / sum(rate(nv_inference_exec_count{namespace=~\"$namespace\", pod=~\"$pod\", model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true
        }
      ]
    },
