          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket{namespace=~\"$namespace\", pod=~\"$pod\", model_name=~\"$model_name\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket{namespace=~\"$namespace\", pod=~\"$pod\", model_name=~\"$model_name\"}[$__rate_interval])))",
          "legendFormat": "p95",
