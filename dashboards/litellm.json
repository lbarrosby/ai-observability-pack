          "expr": "sum(rate(litellm_input_tokens_metric_total{requested_model=~\"$model\", team_alias=~\"$team\"}[$__rate_interval])) + sum(rate(litellm_output_tokens_metric_total{requested_model=~\"$model\", team_alias=~\"$team\"}[$__rate_interval]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total latency p95",
      "description": "p95 total request latency at the proxy.",
