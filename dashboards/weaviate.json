      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(queries_durations_ms_bucket{namespace=~\"$namespace\", pod=~\"$pod\", class_name=~\"$collection\"}[$__rate_interval])))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true
        }
      ]
    },
