{
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Weaviate vector database (PROMETHEUS_MONITORING_ENABLED=true, port 2112): HTTP API, queries, batch imports, vector index (HNSW) size and queues, LSM storage and shards.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "ai-observability"
      ],
      "targetBlank": false,
      "title": "AI observability",
      "type": "dashboards"
    },
    {
      "title": "TEI",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/ai-obs-hf-tei",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "asDropdown": false,
      "tags": [],
      "tooltip": "Related dashboard"
    },
    {
      "title": "Qdrant",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/ai-obs-qdrant",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "asDropdown": false,
      "tags": [],
      "tooltip": "Related dashboard"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Collections",
      "description": "Collections (classes) in the schema.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "decimals": 0,
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max(weaviate_schema_collections{namespace=~\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Vectors indexed",
      "description": "Vectors in the HNSW indexes of the selected collections.",
