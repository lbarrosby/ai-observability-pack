          "editorMode": "code",
          "expr": "(sum(rate(weaviate_http_request_duration_seconds_count{namespace=~\"$namespace\", pod=~\"$pod\", status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(weaviate_http_request_duration_seconds_count{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true
